PORT=3000
NODE_ENV=development

# En production, definir NODE_ENV=production (desactive synchronize,
# active les migrations automatiques) et renseigner FRONTEND_URL pour
# restreindre le CORS a votre propre frontend.
FRONTEND_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smart_gestion_pro

# Sauvegarde automatique vers Google Drive (optionnel).
# Voir README section "Sauvegardes vers Google Drive" pour la procedure
# complete de creation du compte de service Google.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=

REDIS_HOST=localhost
REDIS_PORT=6379

# IMPORTANT : generer une valeur unique en production, ex: openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
